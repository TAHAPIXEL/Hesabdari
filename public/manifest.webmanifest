{
  "id": "/",
  "name": "نوین آشپزخانه — حسابداری و فروش",
  "short_name": "نوین آشپزخانه",
  "description": "سامانه جامع حسابداری، صدور فاکتور، بارکدخوان فوق‌سریع و مدیریت انبار نوین آشپزخانه با اجرای کامل آفلاین و همگام‌سازی ابری خودکار",
  "lang": "fa-IR",
  "dir": "rtl",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0C2337",
  "theme_color": "#0C2337",
  "categories": ["finance", "business", "productivity", "shopping"],
  "prefer_related_applications": false,
  "launch_handler": {
    "client_mode": "focus-existing"
  },
